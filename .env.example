# Nod configuration. Copy to .env and fill in what you need: cp .env.example .env
#
# Mock mode needs NOTHING from this file: `docker compose --profile mock up` and `make mock` run
# without a .env. Live mode (the Nebius GPU VM) needs at least NEBIUS_API_KEY, HF_TOKEN,
# NOD_DOMAIN and VIEW_DOMAIN. Never commit .env (it is git-ignored).
#
# Every gateway setting is an environment variable with the NOD_ prefix, read by pydantic-settings
# in gateway/nod_gateway/config.py (design 4.2.2). Lines left commented keep the default shown.
# infra/tests/test_infra.py checks that every Config field is listed here.

# ----------------------------------------------------------------------------- secrets
# Nebius Token Factory key (https://tokenfactory.nebius.com/project/api-keys). The gateway also
# accepts it as NOD_TF_API_KEY.
NEBIUS_API_KEY=
# Hugging Face read token from an account granted access to nvidia/Cosmos-Reason2-2B (GR00T N1.7
# backbone) and nvidia/Cosmos-Reason2-8B (the verifier). Used by the policy, cosmos and eval services.
HF_TOKEN=
# Home Assistant long-lived access token (HA > Profile > Security). Only with the hass profile.
NOD_HASS_TOKEN=

# ----------------------------------------------------------------------------- mode and server
# mock: FakePlanner, FakeASR, FakeCosmos, FakeHome and the in-process MockRunner. live: real clients.
# compose sets this per service; it matters when you run the gateway by hand.
NOD_MODE=mock
# NOD_DEV=false                 # true enables /api/dev/inject in live mode (always on in mock)
# NOD_HOST=127.0.0.1            # nod-gateway bind address (compose uses 0.0.0.0 inside the container)
# NOD_PORT=8000

# ----------------------------------------------------------------------------- TLS host names (live)
# create_vm.sh prints these. sslip.io resolves nod.1-2-3-4.sslip.io to 1.2.3.4 (design 3.1).
NOD_DOMAIN=nod.localhost
VIEW_DOMAIN=view.localhost

# ----------------------------------------------------------------------------- Nemotron (design 7.1)
# NOD_TF_FAST_URL=https://api.tokenfactory.nebius.com/v1/
# NOD_TF_PLAN_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# NOD_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
# NOD_PLAN_MODEL=nvidia/nemotron-3-super-120b-a12b
# NOD_FAST_TIMEOUT_S=2.5
# NOD_PLAN_TIMEOUT_S=8.0
# auto | json_schema | tools | json_object. Set from the Day-1 G3 result (docs/runbooks/day1-results.md).
# NOD_PLANNER_STRUCTURED=auto

# ----------------------------------------------------------------------------- sim link (design 3.3)
# Live defaults point at the compose service "sim". In mock mode they are rewritten to 127.0.0.1.
# NOD_SIM_CTL=tcp://sim:5560
# NOD_SIM_ESTOP=tcp://sim:5561
# NOD_SIM_PUB=tcp://sim:5562
# NOD_SIM_POSE_PUB=tcp://sim:5563
# NOD_SCENE_ID=libero_goal_v1
# NOD_INIT_INDEX=0
# NOD_SIM_ACK_TIMEOUT_S=3.0
# NOD_SIM_STATUS_TIMEOUT_S=5.0
# Sim actor: policy (GR00T) or scripted (fallback tier T4, design 1.6). Read by the sim service.
# NOD_ACTOR=policy

# ----------------------------------------------------------------------------- Cosmos verifier
# Empty in live mode means checks are skipped and the sim oracle decides. compose sets
# http://cosmos:8001/v1 for the live gateway.
# NOD_COSMOS_URL=http://cosmos:8001/v1
# NOD_COSMOS_MODEL=nvidia/Cosmos-Reason2-8B
# NOD_COSMOS_TIMEOUT_S=4.0
# JSON list of cameras sent with each check.
# NOD_COSMOS_CAMERAS=["frontview"]

# ----------------------------------------------------------------------------- Home Assistant
# Set NOD_HASS_URL to use the real HA (compose service homeassistant); empty uses FakeHome.
# NOD_HASS_URL=http://homeassistant:8123
# NOD_HASS_LIGHT_ENTITY=light.ceiling_lights
# NOD_HASS_NOTIFY_SERVICE=persistent_notification

# ----------------------------------------------------------------------------- safety (design 5.2, 5.6)
# NOD_HB_TIMEOUT_MS=500
# NOD_FACE_LOST_MS=1000
# NOD_PROPOSAL_TTL_S=30
# NOD_ARM_DELAY_MS=300
# NOD_FOCUS_DWELL_MS=300
# NOD_MIN_CONFIRM_HOLD_MS=600
# NOD_COUNTDOWN_S=1.0
# NOD_PLAN_COUNTDOWN_S=3.0
# NOD_SPACING_MS=2000
# NOD_NEAR_USER_SCALE=0.6
# NOD_ESTOP_ACK_WAIT_MS=1000
# Caregiver gate for risk: high skills (R7). Leave false for the user's session.
# NOD_CAREGIVER_ENABLED=false
# per_step | whole
# NOD_PLAN_MODE=per_step
# NOD_PREFERRED_NAME=
# NOD_CAREGIVER_NAME=

# ----------------------------------------------------------------------------- dependency overrides
# Empty means chosen by NOD_MODE. Example: NOD_MODE=mock NOD_PLANNER=nemotron tries the real
# planner against the mock sim.
# NOD_PLANNER=                  # nemotron | fake
# NOD_ASR=                      # parakeet | fake
# NOD_COSMOS=                   # vllm | fake | none
# NOD_HOME=                     # hass | fake
# NOD_MOCK_RUNNER=              # true | false (default: on in mock mode)

# ----------------------------------------------------------------------------- mock runner
# NOD_MOCK_HZ=20
# NOD_MOCK_STEPS=60
# NOD_MOCK_FAILURE_RATE=0.0
# NOD_MOCK_SEED=0
# NOD_MOCK_HB_TIMEOUT_MS=500

# ----------------------------------------------------------------------------- paths
# Defaults are relative to the repo root, which also holds inside the gateway image (/app).
# NOD_REGISTRY_PATH=registry/skills.yaml
# NOD_STATS_PATH=registry/stats/latest.json
# NOD_PWA_DIR=pwa
# NOD_RUNS_DIR=runs
# NOD_RECORDINGS_DIR=recordings
# NOD_CANNED_DIR=gateway/nod_gateway/planner/canned
# JSON list of transcripts FakeASR returns in turn.
# NOD_FAKE_TRANSCRIPTS=["I'm a bit hungry"]

# ----------------------------------------------------------------------------- nightly eval (compose profile eval)
# NOD_EVAL_EPISODES=20
# NOD_EVAL_CHAINS=A,B
# TZ=Etc/UTC

# ----------------------------------------------------------------------------- Nebius (infra/nebius/*.sh)
# Used on the laptop or in CI, not by the services. See docs/TEAM-TODO.md for where to find each id.
# NEBIUS_PROJECT_ID=            # TODO: uk-south2 project id
# NEBIUS_REGION=uk-south2
# NOD_EVAL_IMAGE=               # TODO: cr.uk-south2.nebius.cloud/<registry_id>/nod-eval:<tag>
# NOD_BUCKET_ID=                # TODO: Object Storage bucket resource id (results)
# NOD_BUCKET_NAME=              # TODO: the same bucket's name (S3 API, --fetch-stats)
# NOD_HF_SECRET=                # TODO: MysteryBox secret selector holding HF_TOKEN

# ----------------------------------------------------------------------------- mock library (make fetch-mock)
# NOD_GITHUB_REPO=<owner>/nod   # TODO: defaults to the origin remote
# NOD_MOCK_TAG=mock-v1
