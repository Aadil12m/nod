              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "K"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p_est": {
          "maximum": 1.0,
          "minimum": 0.0,
