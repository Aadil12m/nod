{
  "$id": "https://nod.invalid/schema/trace.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "planner",
        "validator",
        "cosmos",
        "run",
        "estop",
        "asr",
        "home"
      ],
      "title": "Kind",
      "type": "string"
    },
    "ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ref"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "sess": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sess"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "type": {
      "const": "trace",
      "default": "trace",
      "title": "Type",
      "type": "string"
    },
    "v": {
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "sess",
    "seq",
    "kind",
    "ref",
    "data"
  ],
  "title": "Trace",
  "type": "object"
}
