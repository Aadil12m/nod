{
  "$id": "https://nod.invalid/schema/notice.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "level": {
      "default": "info",
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "title": "Level",
      "type": "string"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "sess": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sess"
    },
    "speak": {
      "default": false,
      "title": "Speak",
      "type": "boolean"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "type": {
      "const": "notice",
      "default": "notice",
      "title": "Type",
      "type": "string"
    },
    "v": {
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "sess",
    "seq",
    "level",
    "text",
    "speak"
  ],
  "title": "Notice",
  "type": "object"
}
