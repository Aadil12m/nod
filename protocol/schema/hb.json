{
  "$id": "https://nod.invalid/schema/hb.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sent every 100 ms on /ws/safety.\n\n`resume_token` is the token from this phone's `welcome` on /ws/phone. It binds the\nheartbeat to the phone session: only the heartbeat of the phone holding the `user` lease\nfeeds the watchdogs and the R9 face check (a `latched` heartbeat from any device still\ncounts as a stop). None until the phone has been welcomed.",
  "properties": {
    "face_present": {
      "title": "Face Present",
      "type": "boolean"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "latched": {
      "title": "Latched",
      "type": "boolean"
    },
    "resume_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Token"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "sess": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sess"
    },
    "track_conf": {
      "title": "Track Conf",
      "type": "number"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "type": {
      "const": "hb",
      "default": "hb",
      "title": "Type",
      "type": "string"
    },
    "v": {
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "sess",
    "seq",
    "face_present",
    "track_conf",
    "fps",
    "latched",
    "resume_token"
  ],
  "title": "Heartbeat",
  "type": "object"
}
