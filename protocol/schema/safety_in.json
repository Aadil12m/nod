        "estop_seq": {
          "title": "Estop Seq",
          "type": "integer"
        },
        "held_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Held Ms"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "seq": {
          "default": 0,
          "title": "Seq",
          "type": "integer"
