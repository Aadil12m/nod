            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sess"
        },
        "track_conf": {
          "title": "Track Conf",
          "type": "number"
        },
        "ts": {
          "title": "Ts",
          "type": "integer"
        },
        "type": {
          "const": "hb",
          "default": "hb",
          "title": "Type",
          "type": "string"
        },
        "v": {
          "default": 1,
          "title": "V",
          "type": "integer"
        }
      },
      "required": [
        "v",
        "type",
        "id",
        "ts",
        "sess",
        "seq",
        "face_present",
        "track_conf",
        "fps",
