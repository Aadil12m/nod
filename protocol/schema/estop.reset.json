{
  "$id": "https://nod.invalid/schema/estop.reset.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Clears the latched stop `estop_seq` (the latest one the phone knows of). Accepted only\nfrom the phone holding the `user` lease (long blink of at least the minimum hold, or a\ncaregiver touch on that phone) or a `caregiver` phone, identified by `resume_token`.",
  "properties": {
    "estop_seq": {
      "title": "Estop Seq",
      "type": "integer"
    },
    "gesture": {
      "title": "Gesture",
      "type": "string"
    },
    "held_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Held Ms"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "resume_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Token"
    },
    "seq": {
      "default": 0,
      "title": "Seq",
      "type": "integer"
    },
    "sess": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sess"
    },
    "ts": {
      "title": "Ts",
      "type": "integer"
    },
    "type": {
      "const": "estop.reset",
      "default": "estop.reset",
      "title": "Type",
      "type": "string"
    },
    "v": {
      "default": 1,
      "title": "V",
      "type": "integer"
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "sess",
    "seq",
    "estop_seq",
    "gesture",
    "held_ms",
    "resume_token"
  ],
  "title": "EStopReset",
  "type": "object"
}
